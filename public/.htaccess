# Hostinger serves static files with a multi-day Cache-Control by default. The
# service worker and the HTML shell are what decide when a client picks up a new
# deploy, so both must be revalidated on every request. A stale sw.js pins a
# device to an old build whose hashed bundles no longer exist on the server,
# which shows up as a permanently blank board.
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|index\.html|manifest\.webmanifest|registerSW\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Everything under assets/ carries a content hash in its filename, so a long
# immutable lifetime is safe and keeps repeat loads off the network.
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|mjs|css|png|jpg|jpeg|svg|woff2|ttf|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
