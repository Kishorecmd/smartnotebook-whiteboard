# Keep this file on the Node server only. Never put this key in a VITE_* variable.
GEMINI_API_KEY=your_gemini_api_key

# Optional: Gemini 3.6 Flash is the multimodal default used by the endpoint.
# GEMINI_HANDWRITING_MODEL=gemini-3.6-flash

# The Node server's port. Vite development mode proxies /api requests to 8787.
PORT=8787

# Optional: requests allowed per source IP per minute.
# HANDWRITING_RATE_LIMIT_MAX=60

# For Capacitor or a separately hosted static frontend, point the browser app at
# the public Node server. Leave unset when Express serves the frontend itself.
# VITE_HANDWRITING_API_BASE_URL=https://whiteboard-api.example.com

# Comma-separated web origins allowed when the API is hosted separately.
# HANDWRITING_ALLOWED_ORIGINS=https://whiteboard.jaihind.school,capacitor://localhost,http://localhost

# Optional: the Antigravity ERP that classroom sign-in talks to. Defaults to
# production. For a local XAMPP copy use http://localhost/Antigravity/public/index.php
# (plain HTTP is accepted only for localhost).
# CLASSROOM_ERP_BASE_URL=https://erp.jaihind.school/public/index.php

# Optional: comma-separated Jaihind LMS origins allowed to embed lesson whiteboards
# (/?lms=view and /?lms=edit). Defaults to https://lms.jaihind.school. Development
# builds also accept http://localhost:* so a local LMS can embed a local board.
# VITE_LMS_ORIGINS=https://lms.jaihind.school
